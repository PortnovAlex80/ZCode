<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>d1b30f18-dba4-4693-b121-918413481861</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Spec Harness</ProviderName>
  <DefaultLocale>ru-RU</DefaultLocale>
  <DisplayName DefaultValue="Spec Harness — Excel"/>
  <Description DefaultValue="Чат ZCODE, обсуждения диапазонов и проверяемые правки внутри Excel. Подключение включается отдельно."/>
  <IconUrl DefaultValue="https://localhost:43483/icon.png"/>
  <SupportUrl DefaultValue="https://localhost:43483/"/>
  <AppDomains><AppDomain>https://localhost:43483</AppDomain></AppDomains>
  <Hosts><Host Name="Workbook"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="ExcelApi"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://localhost:43483/"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="AddinCommands"/><bt:Set Name="SharedRuntime"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="Workbook"><Runtimes><Runtime resid="Panel.Url" lifetime="long"/></Runtimes><DesktopFormFactor>
      <FunctionFile resid="Panel.Url"/>
      <ExtensionPoint xsi:type="PrimaryCommandSurface">
        <OfficeTab id="TabHome"><Group id="SpecHarness.Group">
          <Label resid="Group.Label"/>
          <Icon><bt:Image size="16" resid="Icon"/><bt:Image size="32" resid="Icon"/><bt:Image size="80" resid="Icon"/></Icon>
          <Control xsi:type="Button" id="SpecHarness.Open">
            <Label resid="Open.Label"/><Supertip><Title resid="Open.Label"/><Description resid="Open.Help"/></Supertip>
            <Icon><bt:Image size="16" resid="Icon"/><bt:Image size="32" resid="Icon"/><bt:Image size="80" resid="Icon"/></Icon>
            <Action xsi:type="ShowTaskpane"><TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId><SourceLocation resid="Panel.Url"/></Action>
          </Control>
        </Group></OfficeTab>
      </ExtensionPoint>
      <ExtensionPoint xsi:type="ContextMenu"><OfficeMenu id="ContextMenuCell">
        <Control xsi:type="Menu" id="SpecHarness.Context">
          <Label resid="Group.Label"/><Supertip><Title resid="Group.Label"/><Description resid="Open.Help"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon"/><bt:Image size="32" resid="Icon"/><bt:Image size="80" resid="Icon"/></Icon>
          <Items>
            <Item id="SpecHarness.Add"><Label resid="Add.Label"/><Supertip><Title resid="Add.Label"/><Description resid="Add.Help"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon"/><bt:Image size="32" resid="Icon"/><bt:Image size="80" resid="Icon"/></Icon>
              <Action xsi:type="ExecuteFunction"><FunctionName>addSelection</FunctionName></Action>
            </Item>
            <Item id="SpecHarness.Discuss"><Label resid="Discuss.Label"/><Supertip><Title resid="Discuss.Label"/><Description resid="Discuss.Help"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon"/><bt:Image size="32" resid="Icon"/><bt:Image size="80" resid="Icon"/></Icon>
              <Action xsi:type="ExecuteFunction"><FunctionName>discussSelection</FunctionName></Action>
            </Item>
          </Items>
        </Control>
      </OfficeMenu></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon" DefaultValue="https://localhost:43483/icon.png"/></bt:Images>
      <bt:Urls><bt:Url id="Panel.Url" DefaultValue="https://localhost:43483/"/><bt:Url id="Add.Url" DefaultValue="https://localhost:43483/?action=add"/><bt:Url id="Discuss.Url" DefaultValue="https://localhost:43483/?action=discuss"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="ZCODE"/><bt:String id="Open.Label" DefaultValue="Панель ZCODE"/><bt:String id="Add.Label" DefaultValue="Добавить в беседу"/><bt:String id="Discuss.Label" DefaultValue="Обсудить отдельно"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Open.Help" DefaultValue="Открыть локальную панель обсуждений Excel без подключения к модели."/><bt:String id="Add.Help" DefaultValue="Взять выбранные ячейки в контекст беседы о документе."/><bt:String id="Discuss.Help" DefaultValue="Создать независимое обсуждение выбранного диапазона."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
