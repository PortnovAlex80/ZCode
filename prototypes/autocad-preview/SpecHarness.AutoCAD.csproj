<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <AssemblyName>SpecHarness.AutoCAD</AssemblyName><GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoCADRoot Condition="'$(AutoCADRoot)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AutoCADRoot>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Verification.cs" Condition="'$(BuildVerification)' != 'true'"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/>
    <Reference Include="AcMgd"><HintPath>$(AutoCADRoot)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADRoot)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADRoot)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
  </ItemGroup>
</Project>
